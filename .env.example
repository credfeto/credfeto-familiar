# Copy to .env next to docker-compose.yaml and fill in. Never commit .env.
# These are the variables docker-compose.yaml reads; `python -m broker.init`
# (see the familiar README) writes a full .env, including anything else the
# broker needs.

# Required: the docker socket's group id (stat -c %g /var/run/docker.sock).
DOCKER_GID=
# Required: the familiar release to run (e.g. 1.0 or latest).
FAMILIAR_RELEASE=

# Optional: image repository (default ghcr.io/funfair-tech/familiar).
FAMILIAR_IMAGE_REPO=
# Optional: instance name, used as a prefix for the broker container name.
FAMILIAR_INSTANCE=

# Optional: data and backup locations (default: named volumes).
FAMILIAR_BACKUPS=
FAMILIAR_DATA=

# Optional: admin UI bind address and port (default 0.0.0.0 and 8081).
FAMILIAR_ADMIN_BIND=
FAMILIAR_ADMIN_PORT=

# Backups: the encryption key for snapshots (a secret), and how many to keep.
FAMILIAR_BACKUP_KEEP=
FAMILIAR_BACKUP_KEY=
